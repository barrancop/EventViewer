{
  "EventApi": {
    "BaseUrl": "https://<gateway-host>",
    "TimeoutSeconds": 30,
    "MaxResults": 1000
  },
  "ApplicationInsights": {
    "WorkspaceId": "your-workspace-id-here",
    "QueryTimeoutSeconds": 60,
    "MaxResults": 10000
  },
  "JsonPersistence": {
    "StoragePath": "./EventFlows",
    "CreateDirectoryIfNotExists": true,
    "UseIndentedJson": true,
    "FileNamePrefix": "EventFlow_",
    "FileExtension": ".json"
  }
}
