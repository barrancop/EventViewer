{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "MetadataAddress": "",
    "Audience": ""
  },
  "AllowedOrigins": [
    "http://localhost:3000",
    "http://localhost:5173"
  ],
  "OpenTelemetry": {
    "ServiceName": "EventViewer.API",
    "OtlpEndpoint": "http://localhost:4318/v1/traces"
  },
  "EventApi": {
    "BaseUrl": "",
    "TimeoutSeconds": 30,
    "MaxResults": 1000
  },
  "ApplicationInsights": {
    "WorkspaceId": "",
    "QueryTimeoutSeconds": 60,
    "MaxResults": 10000,
    "LogsWindowMinutesBefore": 1,
    "LogsWindowMinutesAfter": 10
  },
  "JsonPersistence": {
    "StoragePath": "./saved-flows"
  }
}
